APP_NAME="TalentSphere"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# CORS / frontend
# Producción: APP_URL y FRONTEND_URL apuntan a https://talentsphere.cloud
FRONTEND_URL=http://localhost:5173
# Página del formulario (public/reset-password.html). Si vacío, usa APP_URL + /reset-password.html
PASSWORD_RESET_URL=
# Tras restablecer contraseña, botón "Ir a iniciar sesión" (SPA). Si vacío, usa FRONTEND_URL
PASSWORD_RESET_RETURN_URL=
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:3000,talentsphere.cloud,www.talentsphere.cloud

# --- Producción (talentsphere.cloud) ---
# APP_URL=https://talentsphere.cloud
# FRONTEND_URL=https://talentsphere.cloud
# PASSWORD_RESET_URL=https://talentsphere.cloud/reset-password.html
# PASSWORD_RESET_RETURN_URL=https://talentsphere.cloud

APP_TIMEZONE=America/Bogota

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=usuarios
DB_USERNAME=root
DB_PASSWORD=

MYSQL_ATTR_SSL_CA=/var/www/html/ca.pem

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TalentSphere"

JWT_SECRET=

# Asistente RRHH (chat): diccionario en BD; OpenAI opcional
CHATBOT_OPENAI_ENABLED=false
OPENAI_API_KEY=
CHATBOT_OPENAI_MODEL=gpt-4o-mini
CHATBOT_OPENAI_TIMEOUT=45
CHATBOT_MAX_CONTEXT_MESSAGES=12
# Máximo de chips de seguimiento en POST mensajes (3–6; por defecto 4)
# CHATBOT_SUGERENCIAS_RELACIONADAS_MAX=4
# Opcional: sustituye el system prompt por defecto del asistente (OpenAI)
# CHATBOT_SYSTEM_PROMPT_BASE="..."